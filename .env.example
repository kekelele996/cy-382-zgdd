# Compose 项目名（容器名统一带 tripmatch- 前缀）
COMPOSE_PROJECT_NAME=tripmatch

# MySQL 初始化配置
MYSQL_ROOT_PASSWORD=tripmatch_root_pass
MYSQL_DATABASE=tripmatch
MYSQL_USER=tripmatch
MYSQL_PASSWORD=tripmatch_pass

# 后端数据库连接（容器内通过服务名 db 访问）
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=tripmatch
DATABASE_USER=tripmatch
DATABASE_PASSWORD=tripmatch_pass

# JWT 签名密钥，生产环境请改成随机长字符串
JWT_SECRET=change_me_in_production

# 高德地图 JS API Key
AMAP_KEY=
